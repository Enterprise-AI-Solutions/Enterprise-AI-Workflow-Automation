{
  "name": "Support Ticket Auto-Responder",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node_webhook_ticket",
      "name": "Webhook — New Support Ticket",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \$env.APP_BASE_URL }}/api/v1/ai/classify",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{ $json.body.subject + ' ' + $json.body.message }}"
            },
            {
              "name": "categories",
              "value": ["Billing", "Technical Bug", "Feature Request", "Account Access", "General Question", "Urgent / Outage"]
            }
          ]
        },
        "options": {}
      },
      "id": "node_claude_classify",
      "name": "Claude — Classify Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [300, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \$env.APP_BASE_URL }}/api/v1/ai/chat",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "You are a friendly and professional customer support agent for Enterprise AI Solutions. A customer has submitted the following support ticket:\n\nSubject: {{ $('Webhook — New Support Ticket').item.json.body.subject }}\nMessage: {{ $('Webhook — New Support Ticket').item.json.body.message }}\nCategory: {{ $('Claude — Classify Ticket').item.json.category }}\n\nWrite a helpful, empathetic first-response email. Acknowledge their issue, provide any immediate advice if possible, and let them know a human agent will follow up within 4 business hours. Do not sign with a specific name — use 'Enterprise AI Support Team'."
            }
          ]
        },
        "options": {}
      },
      "id": "node_claude_draft",
      "name": "Claude — Draft Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [300, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $('Claude — Classify Ticket').item.json.category }}",
              "operation": "equals",
              "value2": "Urgent / Outage"
            }
          ]
        }
      },
      "id": "node_route_urgent",
      "name": "Route — Urgent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [540, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \$env.APP_BASE_URL }}/api/v1/airtable/bases/{{ $env.AIRTABLE_BASE_ID }}/tables/Support Tickets/records",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": {
                "Customer Email": "={{ $('Webhook — New Support Ticket').item.json.body.from }}",
                "Subject": "={{ $('Webhook — New Support Ticket').item.json.body.subject }}",
                "Category": "={{ $('Claude — Classify Ticket').item.json.category }}",
                "Priority": "={{ $('Claude — Classify Ticket').item.json.category === 'Urgent / Outage' ? 'Critical' : 'Normal' }}",
                "Status": "Open",
                "AI Draft": "={{ $('Claude — Draft Response').item.json.response }}",
                "Created": "={{ $now }}"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "node_airtable_ticket",
      "name": "Airtable — Log Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [760, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \$env.APP_BASE_URL }}/api/v1/google/gmail/send",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "to",
              "value": "={{ $('Webhook — New Support Ticket').item.json.body.from }}"
            },
            {
              "name": "subject",
              "value": "Re: {{ $('Webhook — New Support Ticket').item.json.body.subject }} [Ticket #{{ $('Airtable — Log Ticket').item.json.id }}]"
            },
            {
              "name": "body",
              "value": "={{ $('Claude — Draft Response').item.json.response }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node_gmail_customer",
      "name": "Gmail — Send to Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [760, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \$env.APP_BASE_URL }}/api/v1/google/gmail/send",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "to",
              "value": "={{ $env.SUPPORT_ESCALATION_EMAIL }}"
            },
            {
              "name": "subject",
              "value": "🚨 URGENT TICKET: {{ $('Webhook — New Support Ticket').item.json.body.subject }}"
            },
            {
              "name": "body",
              "value": "URGENT support ticket requires immediate attention!\n\nFrom: {{ $('Webhook — New Support Ticket').item.json.body.from }}\nSubject: {{ $('Webhook — New Support Ticket').item.json.body.subject }}\nMessage: {{ $('Webhook — New Support Ticket').item.json.body.message }}\n\nAI Classification: {{ $('Claude — Classify Ticket').item.json.category }}\n\nTicket logged in Airtable. Please respond immediately."
            }
          ]
        },
        "options": {}
      },
      "id": "node_gmail_escalate",
      "name": "Gmail — Escalate to Team",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [760, 500]
    }
  ],
  "connections": {
    "Webhook — New Support Ticket": {
      "main": [
        [
          { "node": "Claude — Classify Ticket", "type": "main", "index": 0 },
          { "node": "Claude — Draft Response", "type": "main", "index": 0 }
        ]
      ]
    },
    "Claude — Classify Ticket": {
      "main": [[{ "node": "Route — Urgent?", "type": "main", "index": 0 }]]
    },
    "Claude — Draft Response": {
      "main": [[{ "node": "Route — Urgent?", "type": "main", "index": 0 }]]
    },
    "Route — Urgent?": {
      "main": [
        [
          { "node": "Airtable — Log Ticket", "type": "main", "index": 0 },
          { "node": "Gmail — Send to Customer", "type": "main", "index": 0 },
          { "node": "Gmail — Escalate to Team", "type": "main", "index": 0 }
        ],
        [
          { "node": "Airtable — Log Ticket", "type": "main", "index": 0 },
          { "node": "Gmail — Send to Customer", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "tags": ["support", "tickets", "ai", "gmail", "airtable", "auto-reply"]
}
