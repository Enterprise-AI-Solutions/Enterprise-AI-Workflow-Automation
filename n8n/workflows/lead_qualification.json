{
  "name": "Lead Qualification & CRM Enrichment",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-qualification",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node_webhook_lead",
      "name": "Webhook -- New Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.groq_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\": \"llama-3.3-70b-versatile\", \"temperature\": 0.3, \"max_tokens\": 1024, \"messages\": [{\"role\": \"system\", \"content\": \"You are a CRM data extraction assistant. Extract structured lead information from messages.\"}, {\"role\": \"user\", \"content\": \"Extract: company_name, company_size, industry, use_case, budget_range, urgency.\\n\\nMessage:\\n{{ $json.body.message }}\\n\\nRespond with ONLY valid JSON with those exact keys.\"}]}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "node_groq_extract",
      "name": "Groq -- Extract Lead Fields",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        300,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.groq_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\": \"llama-3.3-70b-versatile\", \"temperature\": 0.3, \"max_tokens\": 1024, \"messages\": [{\"role\": \"system\", \"content\": \"You are a sales lead qualification assistant.\"}, {\"role\": \"user\", \"content\": \"Classify this lead into exactly one category: Hot Lead, Warm Lead, Cold Lead, Not a Fit.\\n\\nMessage:\\n{{ $json.body.message }}\\n\\nRespond with ONLY valid JSON: {\\\"category\\\": \\\"<chosen category>\\\"}\"}]}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "node_groq_score",
      "name": "Groq -- Score Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        300,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const extractRaw = $('Groq -- Extract Lead Fields').item.json?.choices?.[0]?.message?.content || '{}';\nconst scoreRaw   = $('Groq -- Score Lead').item.json?.choices?.[0]?.message?.content || '{\"category\":\"Cold Lead\"}';\nlet extracted = {}, score = 'Cold Lead';\ntry { const m = extractRaw.match(/\\{[\\s\\S]*\\}/); if(m) extracted = JSON.parse(m[0]); } catch(e){}\ntry { const m = scoreRaw.match(/\\{[^}]+\\}/);   if(m) score = JSON.parse(m[0]).category; } catch(e){}\nreturn [{ json: { ...extracted, category: score } }];"
      },
      "id": "node_merge_lead",
      "name": "Code -- Merge Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.category }}",
              "operation": "equals",
              "value2": "Hot Lead"
            }
          ]
        }
      },
      "id": "node_route_hot",
      "name": "Route -- Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        740,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.airtable.com/v0/{{ $('Webhook -- New Lead').item.json.body.airtable_base_id || 'YOUR_BASE_ID' }}/Leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Webhook -- New Lead').item.json.body.airtable_token || 'YOUR_TOKEN' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"records\":[{\"fields\":{\"Source\":\"n8n-webhook\",\"Company\":\"{{ $json.company_name }}\",\"Industry\":\"{{ $json.industry }}\",\"Company Size\":\"{{ $json.company_size }}\",\"Use Case\":\"{{ $json.use_case }}\",\"Budget\":\"{{ $json.budget_range }}\",\"Score\":\"{{ $json.category }}\",\"Urgency\":\"{{ $json.urgency }}\",\"Status\":\"New\"}}]}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "node_airtable_crm",
      "name": "Airtable -- Log to CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Webhook -- New Lead').item.json.body.sales_team_email || 'sales@company.com' }}",
        "subject": "=Hot Lead: {{ $json.company_name }}",
        "emailType": "text",
        "message": "=A hot lead just came in!\n\nCompany: {{ $json.company_name }}\nIndustry: {{ $json.industry }}\nBudget: {{ $json.budget_range }}\nUse Case: {{ $json.use_case }}\nUrgency: {{ $json.urgency }}\n\nCheck Airtable for full details.",
        "options": {}
      },
      "id": "node_gmail_alert",
      "name": "Gmail -- Alert Sales Team",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        960,
        420
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail_creds",
          "name": "Gmail OAuth2"
        }
      }
    }
  ],
  "connections": {
    "Webhook -- New Lead": {
      "main": [
        [
          {
            "node": "Groq -- Extract Lead Fields",
            "type": "main",
            "index": 0
          },
          {
            "node": "Groq -- Score Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Groq -- Extract Lead Fields": {
      "main": [
        [
          {
            "node": "Code -- Merge Lead Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Groq -- Score Lead": {
      "main": [
        [
          {
            "node": "Code -- Merge Lead Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code -- Merge Lead Data": {
      "main": [
        [
          {
            "node": "Route -- Hot Lead?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route -- Hot Lead?": {
      "main": [
        [
          {
            "node": "Airtable -- Log to CRM",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Gmail -- Alert Sales Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Airtable -- Log to CRM": {
      "main": [
        [
          {
            "node": "Gmail -- Alert Sales Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    "leads",
    "crm",
    "ai",
    "airtable",
    "gmail",
    "groq"
  ]
}